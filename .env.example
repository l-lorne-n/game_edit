# 可选：不写时默认走 apiyi；如果要切到 openrouter 再取消注释
#LLM_PROVIDER=apiyi

# 最小可用配置（推荐）
APIYI_LLM_API_KEY=
MODEL_CALL_TIMEOUT_MS=120000

# 可选：如果你要覆盖默认 provider 地址或模型名，再取消注释
#APIYI_BASE_URL=https://api.apiyi.com/v1
#APIYI_LOGIC_MODEL=gpt-5.4
#APIYI_STYLE_MODEL=gemini-3.1-pro-preview

# ---------- Server-backed rehearsal infra ----------
# PostgreSQL / Neon
#DATABASE_URL=postgres://user:password@host:5432/database

# Storage provider: local（默认，无 blob token 时）| blob
#STORAGE_PROVIDER=local
#STORAGE_PROVIDER=blob

# Vercel Blob（使用 blob provider 时需要）
#BLOB_READ_WRITE_TOKEN=

# Local storage path（使用 local provider 时可选）
#LOCAL_STORAGE_PATH=.storage

# 本地预览 URL（local provider 生成公开 URL 时使用）
#NEXT_PUBLIC_APP_URL=http://localhost:3000

# Reserved Vercel Sandbox seam（本轮只预留接口，不替换当前 iframe 预览）
#VERCEL_SANDBOX_TEAM_SLUG=
#VERCEL_SANDBOX_PROJECT_NAME=

# 如果你要改用 openrouter，再填写这组
#LLM_PROVIDER=openrouter
#OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
#OPENROUTER_LLM_API_KEY=
#OPENROUTER_LOGIC_MODEL=openai/gpt-5.4
#OPENROUTER_STYLE_MODEL=google/gemini-3.1-pro-preview

# 以下两项主要给第一版 DSL 流程保留
#MAX_REPAIR_ATTEMPTS=1
#SMOKE_SIM_TICKS=600
